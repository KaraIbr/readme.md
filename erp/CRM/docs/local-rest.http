@baseUrl = http://127.0.0.1:8000/api/v1
@token = paste-access-token-here
@promoterId = 1
@contactId = 1
@companyPersonId = 1
@leadId = 1
@proposalId = 1
@technicalVisitId = 1
@technicalVisitAttachmentId = 1

# Create users, login, and grant `crm` service access in the sibling IAM service.
# Paste the IAM access_token into @token before calling CRM endpoints.

### Bootstrap first CRM admin access
# Run once after IAM grants the user access to service key `crm`.
POST {{baseUrl}}/permissions/users/1/role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "admin"
}

### Create promoter
# Copy the returned id into @promoterId.
POST {{baseUrl}}/contacts/promoters
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Referral Partner",
  "phone": "+52 81 5555 0000"
}

### List promoters
GET {{baseUrl}}/contacts/promoters
Authorization: Bearer {{token}}

### Create company contact
# Copy the returned id into @contactId.
POST {{baseUrl}}/contacts/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "COMPANY",
  "name": "Acme Manufacturing",
  "promoter_id": {{promoterId}},
  "address_line": "Av Solar 123",
  "city": "Monterrey",
  "state": "Nuevo Leon",
  "postal_code": "64000",
  "industry": "Manufacturing",
  "company_people": [
    {
      "name": "Jane Manager",
      "phone": "+52 81 5555 0101",
      "email": "jane.manager@acme.example",
      "position": "Facility Manager"
    }
  ]
}

### Add company person
# Copy the returned id into @companyPersonId.
POST {{baseUrl}}/contacts/{{contactId}}/people
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "John CFO",
  "phone": "+52 81 5555 0202",
  "position": "CFO"
}

### List company people
GET {{baseUrl}}/contacts/{{contactId}}/people
Authorization: Bearer {{token}}

### List contacts
GET {{baseUrl}}/contacts/
Authorization: Bearer {{token}}

### Create lead
# Use a contact id owned by this user. Copy the returned id into @leadId.
POST {{baseUrl}}/leads/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contact_id": {{contactId}},
  "title": "Solar 8.5 kW - Acme Manufacturing",
  "interest_type": "Photovoltaic",
  "qualification_score": 72,
  "notes": "Local manual test lead"
}

### Upload lead project document
POST {{baseUrl}}/leads/{{leadId}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=lead-document-boundary

--lead-document-boundary
Content-Disposition: form-data; name="title"

Project requirements
--lead-document-boundary
Content-Disposition: form-data; name="file"; filename="requirements.txt"
Content-Type: text/plain

Customer-provided project requirements.
--lead-document-boundary--

### Upload lead electricity bill
POST {{baseUrl}}/leads/{{leadId}}/electricity-bills
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=lead-bill-boundary

--lead-bill-boundary
Content-Disposition: form-data; name="title"

March CFE receipt
--lead-bill-boundary
Content-Disposition: form-data; name="file"; filename="cfe-march.txt"
Content-Type: text/plain

Electricity bill placeholder content.
--lead-bill-boundary--

### Document lead interaction
POST {{baseUrl}}/leads/{{leadId}}/interactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "interaction_type": "NEGOTIATION",
  "title": "Initial negotiation",
  "notes": "Customer asked for phased delivery and O&M.",
  "interaction_date": "2026-06-15T16:30:00"
}

### Set lead technical visit requirement
POST {{baseUrl}}/leads/{{leadId}}/technical-visit-requirement
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "requirement": "REQUIRED"
}

### Create scheduled technical visit
# Copy the returned id into @technicalVisitId.
POST {{baseUrl}}/leads/{{leadId}}/technical-visits
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "scheduled_at": "2026-06-20T16:30:00",
  "receiver_name": "Jane Manager",
  "receiver_phone": "+52 81 5555 0101",
  "notes": "Access through loading dock.",
  "assignees": [
    {
      "name": "Engineer One"
    },
    {
      "name": "Engineer Two"
    }
  ]
}

### List lead technical visits
GET {{baseUrl}}/leads/{{leadId}}/technical-visits
Authorization: Bearer {{token}}

### Upload technical visit evidence
# file_kind can be DOCUMENT, PHOTO, or OTHER. Copy returned id into @technicalVisitAttachmentId.
POST {{baseUrl}}/technical-visits/{{technicalVisitId}}/attachments
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=technicalVisitAttachmentBoundary

--technicalVisitAttachmentBoundary
Content-Disposition: form-data; name="title"

Inspection report
--technicalVisitAttachmentBoundary
Content-Disposition: form-data; name="file_kind"

DOCUMENT
--technicalVisitAttachmentBoundary
Content-Disposition: form-data; name="file"; filename="inspection-report.pdf"
Content-Type: application/pdf

< ./inspection-report.pdf
--technicalVisitAttachmentBoundary--

### Complete technical visit
POST {{baseUrl}}/technical-visits/{{technicalVisitId}}/complete
Authorization: Bearer {{token}}

### Move lead to proposal phase
POST {{baseUrl}}/leads/{{leadId}}/stage
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "stage": "PROPOSAL_PHASE"
}

### Create proposal
# Copy the returned id into @proposalId.
POST {{baseUrl}}/proposals/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "lead_id": {{leadId}},
  "name": "Acme rooftop PV option",
  "version": "1.0",
  "installation_address": {
    "address_line": "Av Solar 123",
    "city": "Monterrey",
    "state": "Nuevo Leon",
    "postal_code": "64000"
  },
  "tariff": "GDMTH",
  "contracted_demand": 120,
  "system_type": "PV",
  "total_price": "250000.00",
  "annual_savings": "78000.00",
  "currency": "MXN",
  "estimated_cost": "180000.00",
  "expected_profit": "70000.00",
  "submitted_at": "2026-06-01T12:00:00",
  "valid_until": "2026-06-30",
  "pv_system": {
    "panel_count": 16,
    "panel_model": "Jinko 550",
    "panel_power": 550,
    "inverter_model": "INV-8K",
    "inverter_count": 1,
    "inverter_power": 8,
    "type_of_surface": "roof",
    "total_power_ac": 8,
    "system_size_kw": 8.5,
    "oversizing_kw": 0.5,
    "estimated_annual_kwh": 12800,
    "estimated_savings_kw": 7.2,
    "connection_mode": "interconnected",
    "cost_watt": "21.1765",
    "price_watt": "29.4118"
  }
}

### Link proposal to technical visit evidence
# relationship_type can be BASED_ON or VALIDATED_BY.
POST {{baseUrl}}/proposals/{{proposalId}}/technical-visits
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "technical_visit_id": {{technicalVisitId}},
  "relationship_type": "BASED_ON",
  "notes": "Proposal version uses field measurements from the visit."
}

### List proposal technical visit evidence links
GET {{baseUrl}}/proposals/{{proposalId}}/technical-visits
Authorization: Bearer {{token}}

### Upload proposal commercial PDF
# Replace proposal.pdf with a local file path supported by your REST client.
POST {{baseUrl}}/proposals/{{proposalId}}/commercial-pdf
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=proposalCommercialBoundary

--proposalCommercialBoundary
Content-Disposition: form-data; name="title"

Commercial proposal v1.0
--proposalCommercialBoundary
Content-Disposition: form-data; name="file"; filename="proposal.pdf"
Content-Type: application/pdf

< ./proposal.pdf
--proposalCommercialBoundary--

### Upload proposal classified document
# classification can be Costs, Technical, or Other.
POST {{baseUrl}}/proposals/{{proposalId}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=proposalDocumentBoundary

--proposalDocumentBoundary
Content-Disposition: form-data; name="title"

Cost breakdown
--proposalDocumentBoundary
Content-Disposition: form-data; name="classification"

Costs
--proposalDocumentBoundary
Content-Disposition: form-data; name="file"; filename="costs.pdf"
Content-Type: application/pdf

< ./costs.pdf
--proposalDocumentBoundary--

### Move proposal to sent
POST {{baseUrl}}/proposals/{{proposalId}}/stage
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "stage": "SENT"
}

### Mark proposal won
POST {{baseUrl}}/proposals/{{proposalId}}/won
Authorization: Bearer {{token}}

### Mark proposal lost
# Use this instead of /won for a losing proposal.
POST {{baseUrl}}/proposals/{{proposalId}}/lost
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "loss_reason": "Customer selected another provider"
}

### Pipeline transitions
GET {{baseUrl}}/pipeline/transitions
Authorization: Bearer {{token}}

### Lead pipeline summary
GET {{baseUrl}}/pipeline/summary/lead/{{leadId}}
Authorization: Bearer {{token}}

### Agent chat
# Requires Azure OpenAI settings in CRM/.env or .env.
POST {{baseUrl}}/agent/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "Que propuestas tengo abiertas para Acme?",
  "history": []
}
