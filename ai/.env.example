# =============================================================================
# Resource A — Azure OpenAI (gpt-5.6-sol, gpt-5.6-terra)
# Portal Target URI may look like:
# https://chatiq.openai.azure.com/openai/responses?api-version=2025-04-01-preview
# Code uses AzureOpenAI + api-version (classic Responses path with api-key header).
# Copy Key + Endpoint from: Azure Portal → resource "chatiq" → Keys and Endpoint
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://chatiq.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=

# =============================================================================
# Resource B — Azure AI Services (DeepSeek-V4-Pro, grok-4.3)
# Target URI example:
# https://ai-asigcha5956ai083120569258.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
# =============================================================================
AZURE_AI_ENDPOINT=https://ai-asigcha5956ai083120569258.services.ai.azure.com
AZURE_AI_API_VERSION=2024-05-01-preview
AZURE_AI_API_KEY=

# Deployment names (Name == Model in your portal)
DEPLOYMENT_GPT_5_6_SOL=gpt-5.6-sol
DEPLOYMENT_GPT_5_6_TERRA=gpt-5.6-terra
DEPLOYMENT_DEEPSEEK_V4_PRO=DeepSeek-V4-Pro
DEPLOYMENT_GROK_4_3=grok-4.3
